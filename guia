export type ImageType = "image/jpeg" | "image/png" | "image/webp";
/**
 * Detecta el tipo real de una imagen por sus "magic bytes".
 * No basta con confiar en el Content-Type que declara el cliente (MASVS / OWASP: validar entradas).
 */
export function sniffImageType(bytes: Uint8Array): ImageType | null {
 if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) {
 return "image/jpeg";
 }
 if (
 bytes.length >= 8 &&
 bytes[0] === 0x89 &&
 bytes[1] === 0x50 &&
 bytes[2] === 0x4e &&
 bytes[3] === 0x47
 ) {
 return "image/png";
 }
 if (
 bytes.length >= 12 &&
 String.fromCharCode(...bytes.slice(0, 4)) === "RIFF" &&
 String.fromCharCode(...bytes.slice(8, 12)) === "WEBP"
 ) {
 return "image/webp";
 }
 return null;
}
Paso 12.2 · Subir y servir la portada
Decisiones de diseño:
• Solo el bibliotecario puede subirla (assertRole) y se comprueba el contenido real antes de
guardar.
• Se guarda como base64 en Firestore (colección bookCovers): para este proyecto evita
configurar Firebase Storage. El límite de 700 000 caracteres respeta el máximo de 1 MiB por
documento.
• La lectura (GET) es pública y con caché de un año: la URL lleva ?v=<coverVersion>, así que
cada cambio genera una URL nueva y la caché nunca sirve una imagen vieja.
• Subir una portada actualiza updatedAt del libro, de modo que la sincronización incremental
la entrega a todos los dispositivos.
• Se escribe una línea de trazabilidad en el log del servidor (quién, qué libro y cuánto pesó), sin
guardar la imagen en el log.
